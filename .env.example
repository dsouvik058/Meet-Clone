# ==========================================
# Google Meet Clone - Environment Variables (Template)
# Copy this file to .env and fill in your values
# ==========================================

# Database Credentials (PostgreSQL)
DB_USER=postgres #or your database username
DB_PASSWORD=postgres #or your database password
DB_HOST=localhost
DB_PORT=5432

# Microservice Database URLs
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/identity_db
MEETING_DB_URL=jdbc:postgresql://localhost:5432/meeting_db
RECORDING_DB_URL=jdbc:postgresql://localhost:5432/recording_db
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db

# JWT Security (Cryptographically Separated Keys)
JWT_ACCESS_SECRET=your-256-bit-super-secret-access-token-key-change-in-prod
JWT_REFRESH_SECRET=your-256-bit-super-secret-refresh-token-key-change-in-prod
# Legacy fallback (optional)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# OAuth2 Google Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FRONTEND_REDIRECT_URI=http://localhost:3000/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8081/auth/oauth/google/callback

# Kafka & Redis
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
