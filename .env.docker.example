# =============================================================
# Google Meet Clone — Docker Environment Configuration (Template)
# Copy this file to .env.docker and customize for your environment
# =============================================================

# PostgreSQL Credentials
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Security
JWT_SECRET=super-secret-key-google-meet-clone-minimum-256-bits-length-change-in-production
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# OAuth2 Google Credentials (Optional for local testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_REDIRECT_URI=http://localhost/auth/callback
GOOGLE_REDIRECT_URI=http://localhost/auth/oauth/google/callback

# AWS S3 Settings (for recording-service)
S3_BUCKET=meet-recordings
AWS_REGION=us-east-1

# Mailtrap / SMTP Settings (for notification-service)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
